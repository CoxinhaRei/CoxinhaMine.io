# No Render, adicione estas variáveis na seção Environment do serviço.
# Use o endpoint HTTPS REST e o token de escrita do seu banco.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: preserve o mesmo nome para continuar usando a base existente.
SAVE_KEY=coxinha:database:v2
# Alternativa ao Redis: somente um disco realmente persistente montado.
# DATA_DIR=/var/data/coxinha

# Servidores regionais. Escolha a região FÍSICA na hospedagem antes de rotular.
# O Render oferece Virgínia (leste dos EUA), mas não São Paulo.
SERVER_REGION=US
SERVER_LOCATION=Virgínia, EUA
# URL pública HTTPS deste serviço, sem barra/caminho. No Render pode usar RENDER_EXTERNAL_URL.
PUBLIC_URL=
# Preencha somente os servidores realmente publicados. Vazios ficam indisponíveis no menu.
BR_SERVER_URL=
US_SERVER_URL=
# Se BR estiver fisicamente em outro lugar, informe a localização verdadeira.
BR_SERVER_LOCATION=São Paulo, Brasil
US_SERVER_LOCATION=Virgínia, EUA
# Caso o frontend esteja num domínio adicional, informe suas origens HTTPS separadas por vírgula.
FRONTEND_ORIGINS=

# Conta DEV opcional; deixe desativada até configurar uma senha privada no Render.
DEV_ACCOUNT_ENABLED=false
DEV_ACCOUNT_NICK=DevTeste
DEV_ACCOUNT_PASSWORD=
